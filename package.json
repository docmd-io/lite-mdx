{
  "name": "lite-mdx",
  "version": "0.1.0",
  "description": "Ultra lightweight, zero-dependency MDX and JSX compiler for markdown engines and browsers.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build >/dev/null && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "mdx",
    "markdown",
    "jsx",
    "lite",
    "minimalist",
    "fast",
    "lightweight",
    "zero-dependency",
    "typescript",
    "javascript",
    "nodejs",
    "browser",
    "docmd"
  ],
  "author": {
    "name": "Ghazi",
    "url": "https://mgks.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/lite-mdx.git",
    "directory": "lite-mdx"
  },
  "bugs": {
    "url": "https://github.com/docmd-io/lite-mdx/issues"
  },
  "homepage": "https://docmd.io",
  "funding": "https://github.com/sponsors/mgks",
  "license": "MIT"
}
